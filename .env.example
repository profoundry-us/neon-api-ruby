# Local-only environment for the opt-in live Neon Auth integration spec
# (spec/integration/neon_auth_live_spec.rb). Copy to .env and adjust:
#
#   cp .env.example .env
#
# spec_helper loads .env via dotenv for local runs only — never in CI (it is
# skipped when ENV["CI"] is set) — and dotenv never overrides a variable that is
# already set in your shell.

# Stable target so the live spec doesn't pick a random project from your org.
NEON_PROJECT_ID=ancient-snow-29704284
NEON_BRANCH_ID=br-round-brook-atrzkgx1

# Your Neon API key. The live spec is skipped entirely unless this is present.
# Leave it commented here to source it from your shell (e.g. ~/.zshrc) so the
# secret stays out of the repo; uncomment only if you prefer it in .env.
# NEON_API_KEY=neon_api_key_...

# Optional: org id used to discover a project only when NEON_PROJECT_ID is unset.
# NEON_ORG_ID=org-...
